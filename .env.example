# All of these are optional -- the app runs with sensible defaults and no
# .env file at all. Copy to .env and uncomment only what you need to change.

# Comma-separated list of origins allowed to call the API via CORS.
# Defaults to "*" (open), which is fine since the frontend is served from
# this same origin. Tighten this if you deploy the frontend separately.
# ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5500

# Host/port the server binds to. Most platforms (Render, Railway, Fly.io)
# inject PORT automatically -- you shouldn't need to set these yourself.
# HOST=0.0.0.0
# PORT=8000
